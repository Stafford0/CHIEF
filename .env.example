# CHIEF local configuration template
# Copy to .env locally when configuration is introduced.
# Never commit real credentials or secrets.

CHIEF_ENVIRONMENT=development
CHIEF_LOG_LEVEL=INFO
CHIEF_OLLAMA_URL=http://127.0.0.1:11434
CHIEF_OLLAMA_MODEL=qwen3:4b
CHIEF_ULTRON_OLLAMA_MODEL=llama3.1:8b
CHIEF_ULTRON_ENABLED=true
CHIEF_MODEL_TIMEOUT_SECONDS=120
CHIEF_MAX_MODEL_RESPONSE_BYTES=2000000
CHIEF_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Keep false for loopback-only use. LAN mode also requires a random 32+ byte token.
CHIEF_ALLOW_PRIVATE_LAN_UI=false
# Generate locally; never commit the real value. Plain LAN HTTP is still not safe.
# CHIEF_API_TOKEN=replace-with-at-least-32-random-bytes
# Add the exact host name or LAN IP used by paired clients.
CHIEF_TRUSTED_HOSTS=127.0.0.1,localhost
# Emergency stop for tool, plan, scheduler, and run-worker execution.
CHIEF_EXECUTION_ENABLED=true
# Applied to authenticated non-loopback clients; loopback traffic is not throttled.
CHIEF_REMOTE_RATE_LIMIT_PER_MINUTE=120
# Total HTTP request-body ceiling, enforced for declared and chunked bodies.
CHIEF_MAX_REQUEST_BYTES=2000000
