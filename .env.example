# CHIEF local configuration template
# Copy to .env locally when configuration is introduced.
# Never commit real credentials or secrets. On Windows, store credentials through /secrets.

CHIEF_ENVIRONMENT=development
CHIEF_LOG_LEVEL=INFO
CHIEF_OLLAMA_URL=http://127.0.0.1:11434
CHIEF_OLLAMA_MODEL=qwen3:4b
CHIEF_ULTRON_OLLAMA_MODEL=llama3.1:8b
CHIEF_ULTRON_ENABLED=true
CHIEF_MODEL_TIMEOUT_SECONDS=120
CHIEF_MAX_MODEL_RESPONSE_BYTES=2000000

# Cloud reasoning is OFF by default even when credentials exist. Enabling this only makes
# configured providers eligible; every cloud-generation request must still explicitly set
# cloud_authorized=true. Model identifiers are operator configuration rather than hard-coded.
# CHIEF_CLOUD_MODEL_FALLBACK_ENABLED=false
# CHIEF_OPENAI_MODEL=
# OPENAI_API_KEY=                  # temporary migration fallback; prefer encrypted vault
# CHIEF_ANTHROPIC_MODEL=
# CHIEF_ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_API_KEY=               # temporary migration fallback; prefer encrypted vault

CHIEF_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CHIEF_ALLOW_PRIVATE_LAN_UI=false
# CHIEF_API_TOKEN=replace-with-at-least-32-random-bytes
CHIEF_TRUSTED_HOSTS=127.0.0.1,localhost
CHIEF_EXECUTION_ENABLED=true
CHIEF_REMOTE_RATE_LIMIT_PER_MINUTE=120
CHIEF_MAX_REQUEST_BYTES=2000000

# Always-on runtime.
# CHIEF_DATABASE_PATH=data/chief.db
# CHIEF_RUNTIME_WORKER_ID=chief-runtime
# CHIEF_RUNTIME_INTERVAL_MS=2000
# CHIEF_RUNTIME_MIN_FREE_DISK_BYTES=536870912
# Windows Service paths are made absolute before startup. The service hosts the API on
# loopback alongside the durable runtime; non-loopback service binding is rejected.
# CHIEF_HOME=C:\path\to\CHIEF
# CHIEF_SERVICE_API_HOST=127.0.0.1
# CHIEF_SERVICE_API_PORT=8000
# PLAYWRIGHT_BROWSERS_PATH=C:\path\to\CHIEF\work\ms-playwright

# Read-only GitHub evidence plane.
# CHIEF_GITHUB_REPOSITORIES=Stafford0/ParcelSignalsSite,Stafford0/CHIEF
# CHIEF_GITHUB_TOKEN=             # temporary migration fallback; prefer encrypted vault

# Read-only Google/Stripe evidence connectors.
# CHIEF_GMAIL_ACCESS_TOKEN=       # temporary migration fallback; prefer encrypted vault
# CHIEF_GOOGLE_CALENDAR_ACCESS_TOKEN=  # temporary migration fallback; prefer encrypted vault
# CHIEF_GOOGLE_CALENDAR_ID=primary
# CHIEF_STRIPE_RESTRICTED_KEY=    # temporary migration fallback; prefer encrypted vault

# ParcelSignals bounded business-intelligence adapter.
# CHIEF_PARCELSIGNALS_SUPABASE_URL=https://project.supabase.co
# CHIEF_PARCELSIGNALS_SUPABASE_SECRET= # temporary migration fallback; prefer encrypted vault

# Receipt-backed SMTP email notification delivery. SMTP password should be stored in the
# encrypted vault as CHIEF_SMTP_PASSWORD. The provider sends only notifications whose attention
# decision is INTERRUPT and records durable attempts/receipts.
# CHIEF_SMTP_HOST=smtp.example.com
# CHIEF_SMTP_PORT=587
# CHIEF_SMTP_FROM=chief@example.com
# CHIEF_NOTIFICATION_EMAIL_TO=owner@example.com
# CHIEF_SMTP_USERNAME=chief@example.com
# CHIEF_SMTP_PASSWORD=            # temporary migration fallback; prefer encrypted vault
# CHIEF_SMTP_USE_SSL=false
# CHIEF_SMTP_STARTTLS=true
