# CHIEF local configuration template
# Copy to .env locally when configuration is introduced.
# Never commit real credentials or secrets.

CHIEF_ENVIRONMENT=development
CHIEF_LOG_LEVEL=INFO
CHIEF_OLLAMA_URL=http://127.0.0.1:11434
CHIEF_OLLAMA_MODEL=qwen3:4b
CHIEF_ULTRON_OLLAMA_MODEL=llama3.1:8b
CHIEF_ULTRON_ENABLED=true
CHIEF_MODEL_TIMEOUT_SECONDS=120
CHIEF_MAX_MODEL_RESPONSE_BYTES=2000000

# Cloud reasoning is OFF by default even when credentials exist. Enabling this only makes
# configured providers eligible; every cloud-generation request must still explicitly set
# cloud_authorized=true. Model identifiers are operator configuration rather than hard-coded.
# CHIEF_CLOUD_MODEL_FALLBACK_ENABLED=false
# CHIEF_OPENAI_MODEL=
# OPENAI_API_KEY=
# CHIEF_ANTHROPIC_MODEL=
# CHIEF_ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_API_KEY=

CHIEF_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Keep false for loopback-only use. LAN mode also requires a random 32+ byte token.
CHIEF_ALLOW_PRIVATE_LAN_UI=false
# Generate locally; never commit the real value. Plain LAN HTTP is still not safe.
# CHIEF_API_TOKEN=replace-with-at-least-32-random-bytes
# Add the exact host name or LAN IP used by paired clients.
CHIEF_TRUSTED_HOSTS=127.0.0.1,localhost
# Emergency stop for tool, plan, scheduler, and run-worker execution.
CHIEF_EXECUTION_ENABLED=true
# Applied to authenticated non-loopback clients; loopback traffic is not throttled.
CHIEF_REMOTE_RATE_LIMIT_PER_MINUTE=120
# Total HTTP request-body ceiling, enforced for declared and chunked bodies.
CHIEF_MAX_REQUEST_BYTES=2000000

# Always-on runtime. The worker advances the durable scheduler -> event -> run pipeline.
# CHIEF_DATABASE_PATH=data/chief.db
# CHIEF_RUNTIME_WORKER_ID=chief-runtime
# CHIEF_RUNTIME_INTERVAL_MS=2000
# The worker enters degraded mode and stops advancing queues below this free-space floor.
# CHIEF_RUNTIME_MIN_FREE_DISK_BYTES=536870912

# Optional read-only GitHub evidence plane. Listing repositories only registers the connector;
# CHIEF still requires an explicit owner consent grant before any scope can be synchronized.
# Multiple repositories are comma separated and must use owner/name form.
# CHIEF_GITHUB_REPOSITORIES=Stafford0/ParcelSignalsSite,Stafford0/CHIEF
# Temporary pre-vault credential source. Prefer a fine-grained read-only token and never commit it.
# CHIEF_GITHUB_TOKEN=github-read-only-token

# Optional Google/Stripe evidence connectors. These temporary environment credentials register
# connectors only; they DO NOT grant CHIEF permission to read a scope. Explicit consent is still
# required through /integrations/{connector_id}/consent before synchronization.
# Gmail intentionally reads metadata/headers/snippets only, never message bodies.
# CHIEF_GMAIL_ACCESS_TOKEN=short-lived-oauth-access-token
# CHIEF_GOOGLE_CALENDAR_ACCESS_TOKEN=short-lived-oauth-access-token
# CHIEF_GOOGLE_CALENDAR_ID=primary
# Use a restricted Stripe key configured with only the read permissions CHIEF needs.
# CHIEF_STRIPE_RESTRICTED_KEY=rk_live_read_only_key

# ParcelSignals business-intelligence adapter. CHIEF calls only the approved server-side
# parcelsignals_national_overview RPC; it receives no arbitrary SQL/query capability.
# This secret is highly privileged and is temporary until CHIEF's encrypted credential vault ships.
# CHIEF_PARCELSIGNALS_SUPABASE_URL=https://project.supabase.co
# CHIEF_PARCELSIGNALS_SUPABASE_SECRET=server-side-secret
